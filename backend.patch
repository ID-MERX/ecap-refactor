+  "Central Province": ["Chibombo", "Kabwe", "Kapiri Mposhi", "Mkushi", "Mumbwa", "Chisamba", "Serenje"],
+  "Southern Province": ["Livingstone", "Mazabuka", "Monze", "Choma", "Kazungula"],
+};
