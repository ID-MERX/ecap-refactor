diff --git a/lib/supersetClient.js b/lib/supersetClient.js
new file mode 100644
index 0000000..36df4d7
--- /dev/null
+++ b/lib/supersetClient.js
@@ -0,0 +1,92 @@
+const axios = require("axios");
+
+/**
+ * Server-side Superset client for embedded dashboards.
+ *
+ * Logs in as the embedder service account (credentials live only in this
+ * server's env), caches the access token, and requests guest tokens.
+ *
+ * Env:
+ *   SUPERSET_URL                 e.g. https://superset.example.com
+ *   SUPERSET_EMBED_USERNAME      service account username
+ *   SUPERSET_EMBED_PASSWORD      service account password
+ *   SUPERSET_USE_CSRF=true       only if your Superset requires a CSRF token
+ *                                for /security/guest_token/ (it didn't for the
+ *                                browser-side flow, so it is off by default)
+ */
+
+const baseUrl = () => String(process.env.SUPERSET_URL || "").replace(/\/+$/, "");
+
+let cachedAccessToken = null; // { token, expiresAt }
+
+const decodeExp = (jwtToken) => {
+  try {
+    const payload = JSON.parse(Buffer.from(jwtToken.split(".")[1], "base64url").toString());
+    return typeof payload.exp === "number" ? payload.exp * 1000 : null;
+  } catch {
+    return null;
+  }
+};
+
+const login = async () => {
+  const { data } = await axios.post(
+    `${baseUrl()}/api/v1/security/login`,
+    {
+      username: process.env.SUPERSET_EMBED_USERNAME,
+      password: process.env.SUPERSET_EMBED_PASSWORD,
+      provider: "db",
+      refresh: false,
+    },
+    { timeout: 15_000 },
+  );
+  const token = data && data.access_token;
+  if (!token) throw new Error("Superset login returned no access token");
+  // Refresh a minute early; fall back to 10 minutes if exp is missing.
+  const exp = decodeExp(token) || Date.now() + 10 * 60 * 1000;
+  cachedAccessToken = { token, expiresAt: exp - 60 * 1000 };
+  return token;
+};
+
+const getAccessToken = async () =>
+  cachedAccessToken && cachedAccessToken.expiresAt > Date.now()
+    ? cachedAccessToken.token
+    : login();
+
+const getCsrfHeaders = async (accessToken) => {
+  if (String(process.env.SUPERSET_USE_CSRF).toLowerCase() !== "true") return {};
+  const response = await axios.get(`${baseUrl()}/api/v1/security/csrf_token/`, {
+    headers: { Authorization: `Bearer ${accessToken}` },
+    timeout: 10_000,
+  });
+  const cookies = (response.headers["set-cookie"] || []).map((c) => c.split(";")[0]).join("; ");
+  return { "X-CSRFToken": response.data.result, ...(cookies ? { Cookie: cookies } : {}) };
+};
+
+const requestGuestToken = async ({ dashboardId, user, rls }, retried = false) => {
+  const accessToken = await getAccessToken();
+  try {
+    const csrfHeaders = await getCsrfHeaders(accessToken);
+    const { data } = await axios.post(
+      `${baseUrl()}/api/v1/security/guest_token/`,
+      { user, resources: [{ type: "dashboard", id: dashboardId }], rls },
+      {
+        headers: { Authorization: `Bearer ${accessToken}`, ...csrfHeaders },
+        timeout: 15_000,
+      },
+    );
+    if (!data || !data.token) throw new Error("Superset returned no guest token");
+    return data.token;
+  } catch (err) {
+    // Access token revoked or expired early: log in again once.
+    if (!retried && err.response && err.response.status === 401) {
+      cachedAccessToken = null;
+      return requestGuestToken({ dashboardId, user, rls }, true);
+    }
+    throw err;
+  }
+};
+
+const isConfigured = () =>
+  Boolean(baseUrl() && process.env.SUPERSET_EMBED_USERNAME && process.env.SUPERSET_EMBED_PASSWORD);
+
+module.exports = { requestGuestToken, isConfigured };
diff --git a/lib/userScope.js b/lib/userScope.js
new file mode 100644
index 0000000..8bf72ea
--- /dev/null
+++ b/lib/userScope.js
@@ -0,0 +1,81 @@
+const axios = require("axios");
+const { DISTRICTS_BY_PROVINCE } = require("../config/geography");
+
+/**
+ * Works out which data a user may see, from their Directus profile.
+ *
+ * The rules deliberately mirror the frontend's useEffectiveDistrict hook, so
+ * the backend and the UI agree. They are based on free-text profile fields
+ * (description / title / location) and should be replaced by explicit
+ * role/scope fields during the backend refactor; this is the one place to change.
+ *
+ * Returns one of:
+ *   { level: "national" }
+ *   { level: "province", province, districts: [...] }
+ *   { level: "district", district }
+ *   { level: "none" }   -> could not determine a scope: deny access to data
+ */
+const deriveScope = (profile, tokenClaims = {}) => {
+  const description = String(profile.description || "").toLowerCase();
+  const roleName =
+    typeof profile.role === "object" && profile.role
+      ? String(profile.role.name || "").toLowerCase()
+      : "";
+  const location = profile.location && profile.location !== "All" ? profile.location : null;
+  const province = profile.title && profile.title !== "All" ? profile.title : null;
+
+  const isAdmin =
+    tokenClaims.admin_access === true ||
+    roleName === "administrator" ||
+    description.includes("admin") ||
+    description === "ecap+ support" ||
+    // The frontend sidebar treats "has a role but no description" as admin.
+    // Kept so existing admin accounts aren't locked out; revisit in the refactor.
+    (!description && Boolean(roleName) && !location && !province);
+  if (isAdmin) return { level: "national" };
+
+  const isProvinceUser = description.includes("provincial") || description.includes("province");
+  if (isProvinceUser) {
+    const districts = province ? DISTRICTS_BY_PROVINCE[province] : null;
+    return districts && districts.length
+      ? { level: "province", province, districts }
+      : { level: "none" };
+  }
+
+  const isDistrictUser = description.includes("district") || Boolean(location);
+  if (isDistrictUser && location) return { level: "district", district: location };
+
+  return { level: "none" };
+};
+
+// Small in-memory cache so we don't call Directus on every request.
+const PROFILE_TTL_MS = 5 * 60 * 1000;
+const profileCache = new Map(); // userId -> { profile, expires }
+
+/**
+ * Loads the caller's profile from Directus using the caller's own token,
+ * so no Directus admin credentials are needed on this server.
+ */
+const getUserProfile = async (userId, accessToken) => {
+  const cached = profileCache.get(userId);
+  if (cached && cached.expires > Date.now()) return cached.profile;
+
+  const directusUrl = String(process.env.DIRECTUS_URL || "").replace(/\/+$/, "");
+  if (!directusUrl) throw new Error("DIRECTUS_URL is not set");
+
+  const response = await axios.get(`${directusUrl}/users/me`, {
+    params: { fields: "id,email,first_name,last_name,description,title,location,role.name" },
+    headers: { Authorization: `Bearer ${accessToken}` },
+    timeout: 10_000,
+  });
+
+  const profile = response.data && response.data.data;
+  if (!profile || profile.id !== userId) {
+    throw new Error("Directus profile does not match the token");
+  }
+
+  profileCache.set(userId, { profile, expires: Date.now() + PROFILE_TTL_MS });
+  return profile;
+};
+
+module.exports = { deriveScope, getUserProfile };
