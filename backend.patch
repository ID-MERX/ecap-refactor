diff --git a/controllers/supersetController.js b/controllers/supersetController.js
new file mode 100644
index 0000000..586817f
--- /dev/null
+++ b/controllers/supersetController.js
@@ -0,0 +1,102 @@
+const { requestGuestToken, isConfigured } = require("../lib/supersetClient");
+const { deriveScope, getUserProfile } = require("../lib/userScope");
+
+/**
+ * POST /superset/guest-token   body: { dashboardId }
+ *
+ * Returns a Superset guest token for an embedded dashboard. The row-level
+ * security (RLS) rules are built here from the authenticated user's scope;
+ * nothing the browser sends can widen what the user sees.
+ *
+ * Env:
+ *   SUPERSET_DASHBOARD_IDS        comma-separated allowlist of embeddable dashboard UUIDs
+ *   SUPERSET_RLS_ENABLED          "true" (default) | "false"
+ *   SUPERSET_RLS_DISTRICT_COLUMN  column name in the Superset datasets (default "district")
+ *   SUPERSET_RLS_DATASET_IDS      optional comma-separated dataset ids; if set, one RLS
+ *                                 rule is emitted per dataset instead of one global rule
+ */
+
+const list = (value) =>
+  String(value || "")
+    .split(",")
+    .map((s) => s.trim())
+    .filter(Boolean);
+
+const sqlString = (value) => `'${String(value).replace(/'/g, "''")}'`;
+
+const districtColumn = () => {
+  const column = String(process.env.SUPERSET_RLS_DISTRICT_COLUMN || "district").trim();
+  if (!/^[A-Za-z_][A-Za-z0-9_.]*$/.test(column)) {
+    throw new Error("SUPERSET_RLS_DISTRICT_COLUMN is not a valid column name");
+  }
+  return column;
+};
+
+const buildRls = (scope) => {
+  if (String(process.env.SUPERSET_RLS_ENABLED || "true").toLowerCase() === "false") return [];
+  if (scope.level === "national") return [];
+
+  const column = districtColumn();
+  const clause =
+    scope.level === "district"
+      ? `${column} = ${sqlString(scope.district)}`
+      : `${column} IN (${scope.districts.map(sqlString).join(", ")})`;
+
+  const datasetIds = list(process.env.SUPERSET_RLS_DATASET_IDS).map(Number).filter(Number.isInteger);
+  return datasetIds.length ? datasetIds.map((dataset) => ({ dataset, clause })) : [{ clause }];
+};
+
+exports.getGuestToken = async (req, res) => {
+  try {
+    if (!isConfigured()) {
+      return res
+        .status(503)
+        .json({ status: "error", message: "Embedded dashboards are not configured." });
+    }
+
+    // This endpoint always needs a verified user, even when AUTH_MODE=log.
+    if (!req.user || !req.accessToken) {
+      return res
+        .status(401)
+        .json({ status: "fail", message: "You are not logged in! Please log in to get access." });
+    }
+
+    const dashboardId = String((req.body && req.body.dashboardId) || "").trim();
+    const allowed = list(process.env.SUPERSET_DASHBOARD_IDS);
+    if (!dashboardId || !allowed.includes(dashboardId)) {
+      return res
+        .status(400)
+        .json({ status: "fail", message: "Unknown or non-embeddable dashboard." });
+    }
+
+    const profile = await getUserProfile(req.user.id, req.accessToken);
+    const scope = deriveScope(profile, req.user);
+    if (scope.level === "none") {
+      return res.status(403).json({
+        status: "fail",
+        message: "Your account has no data scope assigned. Please contact an administrator.",
+      });
+    }
+
+    const token = await requestGuestToken({
+      dashboardId,
+      user: {
+        username: profile.email || profile.id,
+        first_name: profile.first_name || "",
+        last_name: profile.last_name || "",
+      },
+      rls: buildRls(scope),
+    });
+
+    return res.status(200).json({ status: "success", token });
+  } catch (err) {
+    const upstream = err.response ? ` (Superset ${err.response.status})` : "";
+    console.error(`[superset] guest token failed${upstream}:`, err.message);
+    return res
+      .status(502)
+      .json({ status: "error", message: "Could not load the dashboard. Please try again." });
+  }
+};
+
+// Exported for tests.
+exports._buildRls = buildRls;
